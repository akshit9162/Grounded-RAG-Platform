# Copy to .env and fill in. Nothing here is required to run the local demo —
# every setting has a zero-dependency fallback (see README "Going to real
# production" table).

# --- Generation (unset = extractive mock, no hallucination risk, no cost) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Embeddings / reranker (unset = TF-IDF / lexical-overlap fallback) ---
EMBEDDING_MODEL=
RERANKER_MODEL=

# --- Backends (memory = zero setup; switch once docker compose services are up) ---
VECTOR_STORE_BACKEND=memory
QDRANT_URL=http://localhost:6333

CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

INGESTION_TRANSPORT=local
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Serving ---
RAG_API_KEY=dev-only-key-change-me
